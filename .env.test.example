# Env khusus TEST (salin menjadi .env.test — file itu gitignored).
# WAJIB database TERPISAH dari DB dev/produksi: test membuat & menghapus
# data (booking, payment, user) dan membersihkan barisnya setelah selesai.
DATABASE_URL="postgresql://user:password@host/padelclub_test?sslmode=require"

# Samakan dengan kredensial seed admin (npm run db:seed:test).
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="admin123"

# Sesi pemain memakai token acak + hash SHA-256 di DB; tidak butuh SESSION_SECRET.
CRON_SECRET="test-cron-secret"
TICKET_QR_SECRET="test-ticket-qr-secret-min-16"

# Driver mock: test tidak pernah memanggil gateway pembayaran sungguhan.
# Notifikasi WhatsApp/Email tidak dipakai di MVP (ADR 0010).
PAYMENT_DRIVER="mock"

# Server dev untuk test (jalankan `npm run dev:test` di terminal lain).
TEST_BASE_URL="http://localhost:3100"
# Akun & nomor HP fiktif khusus test — dipakai untuk cleanup.
TEST_EMAIL="pemain-test@padelclub.test"
TEST_PASSWORD="rahasia-test-123"
TEST_PHONE="6280000000001"

# Neon default-nya menamai database "neondb" (tanpa kata "test"). Guard test
# hanya menerima nama DB ber-"test"; bila DB ini memang KHUSUS test, set "1".
# Jangan set 1 kalau DB ini juga dipakai dev/produksi.
TEST_DB_CONFIRMED="0"
