# Neon PostgreSQL
# Salin file ini menjadi .env lalu isi connection string asli dari dashboard Neon.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Sesi pelanggan memakai token acak 32 byte + hash SHA-256 di DB — tidak butuh
# secret tambahan (SESSION_SECRET tidak dipakai).

# Driver pembayaran (mock = tanpa kredensial, end-to-end lokal).
# Ganti ke "midtrans" hanya di .env lokal setelah kredensial Midtrans diisi.
# Notifikasi WhatsApp/Email tidak dipakai di MVP (ADR 0010).
PAYMENT_DRIVER="mock"

# Midtrans (Snap popup, ADR 0008; sebelumnya QRIS Core API, ADR 0007).
# JANGAN isi nilai asli di file ini — file ini masuk git. Isi hanya di .env lokal.
# Sandbox: server key diawali "SB-Mid-server-", client key "SB-Mid-client-".
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_QRIS_ACQUIRER="gopay"

# Snap popup: client key dipakai browser via snap.js — public by design, tetap
# hanya diisi di .env lokal (bukan di file contoh ini).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
# URL publik aplikasi (untuk override notifikasi + finish callback per transaksi).
# Contoh lokal via ngrok: "https://xxx.ngrok-free.dev". Kosongkan bila memakai dashboard.
APP_PUBLIC_URL=""

# Cron internal (dipakai /api/cron/*). Wajib di produksi; tanpa secret route
# mengizinkan akses (perilaku dev). Vercel Cron mengirim Authorization: Bearer.
CRON_SECRET="ganti-dengan-string-acak-untuk-cron"

# Tanda tangan QR tiket (ADR 0014). Minimal 16 karakter, wajib di produksi;
# tanpa ini server menolak menandatangani QR di produksi. Rotasi secret
# membuat semua QR lama langsung tidak valid.
TICKET_QR_SECRET="ganti-dengan-string-acak-minimal-16-karakter"

# Seed admin default (npm run db:seed). Ganti password setelah login pertama.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="admin123"

# Cache jadwal slot per tanggal (ms). Polling klien memakai versi + 304, jadi
# nilai ini hanya membatasi selisih maksimal antar-instance. Default 5000.
SLOTS_CACHE_TTL_MS="5000"