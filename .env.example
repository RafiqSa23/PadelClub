# Neon PostgreSQL
# Salin file ini menjadi .env lalu isi connection string asli dari dashboard Neon.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Sesi pelanggan (HMAC-SHA256, tanpa dep eksternal). Wajib diganti di produksi.
SESSION_SECRET="ganti-dengan-string-acak-min-32-karakter"

# Driver pembayaran & notifikasi (mock = tanpa kredensial, end-to-end lokal).
PAYMENT_DRIVER="mock"
NOTIFY_DRIVER="mock"

# Cron internal (dipakai /api/cron/* di batch berikutnya).
CRON_SECRET="ganti-dengan-string-acak-untuk-cron"

# Seed admin default (npm run db:seed). Ganti password setelah login pertama.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="admin123"